# ============================================================
# MediQueue Backend Configuration
# ============================================================
# Fill in your PostgreSQL password below before running.

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_POSTGRES_PASSWORD_HERE
PGDATABASE=mediqueue_db

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=mediqueue_super_secret_dev_key_change_me_in_production
JWT_EXPIRES_IN=12h

# --- CORS ---
CLIENT_URL=http://localhost:5173

# --- Email / SMTP ---
# Required for real password reset emails.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-character-gmail-app-password
# SMTP_FROM="MediQueue <your-address@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
